<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="lab_world">

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
      <cast_shadows>1</cast_shadows>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>1</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Brick wall left -->
    <model name="brick_wall_left">
      <static>1</static>
      <pose>-2.46405 -1.10882 0.75 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 4 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 4 1.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.32 0.22 1</ambient>
            <diffuse>0.75 0.38 0.26 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Brick wall right -->
    <model name="brick_wall_right">
      <static>1</static>
      <pose>-0.347347 0.968595 0.75 0 0 1.5708</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 4 1.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 4 1.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.32 0.22 1</ambient>
            <diffuse>0.75 0.38 0.26 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle box -->
    <model name="obstacle_box">
      <static>1</static>
      <pose>1.51611 -3.24702 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.5 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.2 0.2 1</ambient>
            <diffuse>0.6 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle cylinder -->
    <model name="obstacle_cylinder">
      <static>1</static>
      <pose>2.87436 -2.43085 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>0.7</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>0.7</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.6 1</ambient>
            <diffuse>0.2 0.2 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Stone -->
    <model name="stone">
      <static>0</static>
      <pose>3.45662 -0.223026 0.125 0 0 0</pose>

      <!-- main body -->
      <link name="stone_link">
        <inertial>
          <mass>0.6</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.13</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.18</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- grasp point for arm attach -->
      <link name="stone_grasp_link">
        <pose>0 0 0.09 0 0 0</pose>
        <inertial>
          <mass>0.0001</mass>
          <inertia>
            <ixx>0.000001</ixx>
            <iyy>0.000001</iyy>
            <izz>0.000001</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <visual name="grasp_visual">
          <geometry>
            <sphere>
              <radius>0.015</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="stone_grasp_joint" type="fixed">
        <parent>stone_link</parent>
        <child>stone_grasp_link</child>
      </joint>
    </model>

    <!-- Container -->
    <model name="container">
      <static>1</static>
      <pose>-1.54015 -1.08473 0 0 0 0</pose>
      <link name="container_link">
        <collision name="base_collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="base_visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.8 1</ambient>
            <diffuse>0.1 0.1 0.8 1</diffuse>
          </material>
        </visual>

        <collision name="wall_collision">
          <geometry>
            <cylinder>
              <radius>0.27</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <cylinder>
              <radius>0.27</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- TurtleBot3 -->
    <include>
      <uri>model://turtlebot3_waffle_pi</uri>
      <name>tb3</name>
      <pose>1.05255 -4.70317 0.007875 0 0.006291 0.000337</pose>
    </include>

    <!-- KUKA iiwa -->
    <include>
      <uri>model://kuka_iiwa_ros2_control</uri>
      <name>lbr_iiwa</name>
      <pose>-1.3 -0.3 0 0 0 0</pose>
    </include>

    <!-- Link attacher plugin -->
    <plugin name="gazebo_ros_link_attacher" filename="libgazebo_ros_link_attacher_plugin.so"/>

  </world>
</sdf>
